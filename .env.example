# Babylon AI Gold Intelligence - Environment Variables Example

# ========== BACKEND CONFIGURATION ==========

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_botfather
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Database Configuration (Optional - for future SQL storage)
DATABASE_URL=postgresql://user:password@localhost:5432/babylon_gold

# Environment
ENVIRONMENT=development
DEBUG=false

# API Configuration
API_TITLE=Babylon AI Gold Intelligence
API_VERSION=1.0.0
API_HOST=0.0.0.0
API_PORT=8000

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,https://babylon-gold.vercel.app,https://babylongold.com

# Data Update Schedule
DATA_UPDATE_SCHEDULE=0 2 * * *  # UTC 02:00 (9:00 Baghdad time)
DATA_UPDATE_INTERVAL_HOURS=4

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# ========== FRONTEND CONFIGURATION ==========

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_NAME=Babylon AI
NEXT_PUBLIC_APP_VERSION=1.0.0

# Feature Flags
NEXT_PUBLIC_ENABLE_NOTIFICATIONS=true
NEXT_PUBLIC_ENABLE_CHARTS=true
NEXT_PUBLIC_ENABLE_BACKTESTING=true

# Analytics (Optional)
NEXT_PUBLIC_GA_ID=

# ========== DEVELOPMENT ONLY ==========

# Hot Reload
NEXT_WEBPACK_USE_POLLING=false

# Mock Data
USE_MOCK_DATA=false

# ========== PRODUCTION SETTINGS ==========

# Security
SECURE_COOKIES=true
SAME_SITE_POLICY=Strict

# Performance
NEXT_PUBLIC_REVALIDATE_INTERVAL=60

# Monitoring
SENTRY_DSN=

# ========== OPTIONAL SERVICES ==========

# Error Tracking (Sentry)
SENTRY_DSN=https://xxxxx@xxxxx.ingest.sentry.io/xxxxx
SENTRY_ENVIRONMENT=production

# Uptime Monitoring
UPTIME_ROBOT_API_KEY=

# Email Notifications (Future)
SMTP_SERVER=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
